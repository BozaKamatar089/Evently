            <com.google.android.material.button.MaterialButton android:id="@+id/btnApprove" style="@style/Widget.Evently.PrimaryButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/action_approve" android:layout_marginStart="5dp" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>