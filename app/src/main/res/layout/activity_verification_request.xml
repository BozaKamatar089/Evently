<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/colorBackground">
    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbar" android:layout_width="match_parent" android:layout_height="?attr/actionBarSize" app:title="@string/verification_request_title" app:navigationIcon="@drawable/ic_back" app:navigationContentDescription="@string/action_back" />
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="20dp" android:paddingBottom="32dp">
                <LinearLayout android:id="@+id/cardStatusPending" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp" android:background="@color/colorWarningContainer" android:visibility="gone">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/verification_pending" android:textAppearance="@style/TextAppearance.Evently.SectionTitle" android:textColor="@color/colorOnWarningContainer" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/verification_pending_body" android:textAppearance="@style/TextAppearance.Evently.Body" android:layout_marginTop="8dp" android:textColor="@color/colorOnWarningContainer" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnCancelRequest" style="@style/Widget.Evently.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/verification_cancel" android:layout_marginTop="12dp" android:textColor="@color/colorOnWarningContainer" />
                </LinearLayout>
                <LinearLayout android:id="@+id/cardStatusApproved" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp" android:background="@color/colorSuccessContainer" android:visibility="gone">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/verification_verified" android:textAppearance="@style/TextAppearance.Evently.SectionTitle" android:textColor="@color/colorOnSuccessContainer" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/verification_verified_body" android:textAppearance="@style/TextAppearance.Evently.Body" android:layout_marginTop="8dp" android:textColor="@color/colorOnSuccessContainer" />
                </LinearLayout>
                <LinearLayout android:id="@+id/cardStatusRejected" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp" android:background="@color/colorErrorContainer" android:visibility="gone">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/verification_rejected" android:textAppearance="@style/TextAppearance.Evently.SectionTitle" android:textColor="@color/colorOnErrorContainer" />
                    <TextView android:id="@+id/tvRejectionReason" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/verification_rejected_body" android:textAppearance="@style/TextAppearance.Evently.Body" android:layout_marginTop="8dp" android:textColor="@color/colorOnErrorContainer" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnRequestAgain" style="@style/Widget.Evently.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/verification_request_again" android:layout_marginTop="12dp" android:textColor="@color/colorOnErrorContainer" />
                </LinearLayout>
                <LinearLayout android:id="@+id/cardRequestForm" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="12dp">
                    <com.example.evently.ui.views.AccessibleHeadingTextView android:id="@+id/tvFormTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/profile_become_organizer" android:textAppearance="@style/TextAppearance.Evently.ScreenTitle" />
                    <TextView android:id="@+id/tvFormDescription" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/verification_request_description" android:textAppearance="@style/TextAppearance.Evently.Meta" android:layout_marginTop="6dp" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="18dp" android:paddingStart="12dp" android:background="@drawable/bg_verification_accent">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/verification_why_title" android:textAppearance="@style/TextAppearance.Evently.EventTitle" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/verification_why_body" android:textAppearance="@style/TextAppearance.Evently.Meta" android:layout_marginTop="4dp" />
                    </LinearLayout>
                    <com.example.evently.ui.views.AccessibleHeadingTextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/verification_org_name" android:textAppearance="@style/TextAppearance.Evently.SettingsSection" android:layout_marginTop="24dp" />
                    <com.google.android.material.textfield.TextInputLayout android:id="@+id/tilOrgName" style="@style/Widget.Evently.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:hint="@string/verification_org_name">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/etOrgName" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textCapWords" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.example.evently.ui.views.AccessibleHeadingTextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/verification_upload_proof" android:textAppearance="@style/TextAppearance.Evently.SettingsSection" android:layout_marginTop="24dp" />
                    <com.google.android.material.card.MaterialCardView style="@style/Widget.Evently.GroupSurface" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:id="@+id/documentSurface" app:strokeWidth="1dp" app:strokeColor="@color/document_stroke">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                            <TextView android:id="@+id/tvUploadPrompt" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/verification_tap_upload" android:textAppearance="@style/TextAppearance.Evently.Meta" />
                            <com.google.android.material.imageview.ShapeableImageView android:id="@+id/ivProofPreview" android:layout_width="match_parent" android:layout_height="144dp" android:layout_marginTop="12dp" android:scaleType="centerCrop" android:background="?attr/colorSurfaceContainerHigh" app:shapeAppearanceOverlay="@style/ShapeAppearance.Evently.Image" android:contentDescription="@string/verification_proof_preview" android:visibility="gone" />
                            <TextView android:id="@+id/tvUploadStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.Evently.Meta" android:layout_marginTop="8dp" android:visibility="gone" android:accessibilityLiveRegion="polite" />
                            <com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/progressUpload" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:visibility="gone" android:contentDescription="@string/e_loading" />
                            <com.google.android.material.button.MaterialButton android:id="@+id/btnSelectProof" style="@style/Widget.Evently.SecondaryButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/verification_select_proof" android:layout_marginTop="12dp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/verification_review_note" android:textAppearance="@style/TextAppearance.Evently.Meta" android:layout_marginTop="20dp" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnSubmitRequest" style="@style/Widget.Evently.PrimaryButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/verification_submit" android:layout_marginTop="12dp" />
                </LinearLayout>
                <TextView android:id="@+id/tvVerificationActionError" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/verification_error" android:textAppearance="@style/TextAppearance.Evently.Meta" android:layout_marginTop="12dp" android:textColor="?attr/colorError" android:visibility="gone" android:accessibilityLiveRegion="polite" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
        <com.example.evently.ui.views.EmptyStateView android:id="@+id/stateVerification" android:layout_width="match_parent" android:layout_height="match_parent" />
        <com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/progressBar" android:layout_width="match_parent" android:layout_height="wrap_content" android:indeterminate="true" android:visibility="gone" android:contentDescription="@string/e_loading" />
    </FrameLayout>
</LinearLayout>