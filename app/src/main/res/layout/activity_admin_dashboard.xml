<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/colorBackground">
    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbar" android:layout_width="match_parent" android:layout_height="?attr/actionBarSize" app:title="@string/admin_dashboard_title" app:navigationIcon="@drawable/ic_back" app:navigationContentDescription="@string/action_back" />
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <androidx.core.widget.NestedScrollView android:id="@+id/contentAdmin" android:layout_width="match_parent" android:layout_height="match_parent">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="16dp" android:paddingBottom="32dp">
                <com.example.evently.ui.views.AccessibleHeadingTextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/admin_pending_section" android:textAppearance="@style/TextAppearance.Evently.ScreenTitle" android:layout_marginTop="10dp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/admin_queue_body" android:textAppearance="@style/TextAppearance.Evently.Meta" android:layout_marginTop="6dp" />
                <TextView android:id="@+id/tvPendingCount" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/admin_verifications_pending" android:textAppearance="@style/TextAppearance.Evently.SettingsSection" android:layout_marginTop="18dp" android:visibility="gone" />
                <androidx.recyclerview.widget.RecyclerView android:id="@+id/recyclerVerifications" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:nestedScrollingEnabled="false" android:clipToPadding="false" android:paddingTop="4dp" android:paddingHorizontal="2dp" />
                <TextView android:id="@+id/tvNoVerifications" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/admin_queue_empty_title" android:textAppearance="@style/TextAppearance.Evently.EventTitle" android:paddingTop="20dp" android:visibility="gone" />
                <TextView android:id="@+id/tvVerificationSectionState" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/admin_section_unavailable" android:textAppearance="@style/TextAppearance.Evently.Meta" android:textColor="?attr/colorError" android:paddingVertical="16dp" android:visibility="gone" android:accessibilityLiveRegion="polite" />
                <com.example.evently.ui.views.AccessibleHeadingTextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/e_admin_overview" android:textAppearance="@style/TextAppearance.Evently.SettingsSection" android:layout_marginTop="24dp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp" android:paddingVertical="12dp" android:background="@drawable/bg_group_surface">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                        <TextView android:id="@+id/tvStatUsers" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.Evently.EventTitle" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/admin_stat_users" android:textAppearance="@style/TextAppearance.Evently.SettingsSummary" />
                    </LinearLayout>
                    <View android:layout_width="1dp" android:layout_height="36dp" android:layout_gravity="center_vertical" android:background="?attr/colorOutlineVariant" android:importantForAccessibility="no" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                        <TextView android:id="@+id/tvStatEvents" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.Evently.EventTitle" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/admin_stat_events" android:textAppearance="@style/TextAppearance.Evently.SettingsSummary" />
                    </LinearLayout>
                    <View android:layout_width="1dp" android:layout_height="36dp" android:layout_gravity="center_vertical" android:background="?attr/colorOutlineVariant" android:importantForAccessibility="no" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                        <TextView android:id="@+id/tvStatRegistrations" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.Evently.EventTitle" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/admin_stat_registrations" android:textAppearance="@style/TextAppearance.Evently.SettingsSummary" />
                    </LinearLayout>
                </LinearLayout>
                <TextView android:id="@+id/tvStatsSectionState" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/admin_section_unavailable" android:textAppearance="@style/TextAppearance.Evently.Meta" android:textColor="?attr/colorError" android:paddingVertical="12dp" android:visibility="gone" />
                <com.example.evently.ui.views.AccessibleHeadingTextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/admin_events_title" android:textAppearance="@style/TextAppearance.Evently.SettingsSection" android:layout_marginTop="24dp" />
                <androidx.recyclerview.widget.RecyclerView android:id="@+id/recyclerAdminEvents" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:nestedScrollingEnabled="false" android:clipToPadding="false" android:paddingTop="4dp" android:paddingHorizontal="2dp" />
                <TextView android:id="@+id/tvNoEvents" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/admin_no_events" android:textAppearance="@style/TextAppearance.Evently.Meta" android:paddingVertical="18dp" android:visibility="gone" />
                <TextView android:id="@+id/tvEventsSectionState" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/admin_section_unavailable" android:textAppearance="@style/TextAppearance.Evently.Meta" android:textColor="?attr/colorError" android:paddingVertical="12dp" android:visibility="gone" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
        <LinearLayout android:id="@+id/stateAdmin" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_vertical" android:padding="32dp" android:visibility="gone">
            <com.example.evently.ui.views.AccessibleHeadingTextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/d1_admin_load_error_title" android:textAppearance="@style/TextAppearance.Evently.SectionTitle" android:gravity="center" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/admin_all_failed_body" android:textAppearance="@style/TextAppearance.Evently.Meta" android:layout_marginTop="8dp" android:gravity="center" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnRetryAdmin" style="@style/Widget.Evently.PrimaryButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/action_retry" android:layout_marginTop="20dp" />
        </LinearLayout>
        <com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/progressBar" android:layout_width="match_parent" android:layout_height="wrap_content" android:indeterminate="true" android:visibility="gone" android:contentDescription="@string/e_loading" />
    </FrameLayout>
</LinearLayout>
