<?xml version='1.0' encoding='utf-8'?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/colorBackground">
    <androidx.core.widget.NestedScrollView android:id="@+id/scrollProfile" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
            <com.example.evently.ui.views.AccessibleHeadingTextView android:id="@+id/tvProfileTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/nav_profile" android:textAppearance="@style/TextAppearance.Evently.ScreenTitle" />
            <com.google.android.material.card.MaterialCardView style="@style/Widget.Evently.GroupSurface" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" app:cardElevation="2dp" app:cardBackgroundColor="@color/colorIdentitySurface">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                        <com.google.android.material.imageview.ShapeableImageView android:id="@+id/ivProfileAvatar" android:layout_width="72dp" android:layout_height="72dp" android:scaleType="centerCrop" android:src="@drawable/profile_placeholder" android:contentDescription="@string/profile_avatar" app:shapeAppearanceOverlay="@style/ShapeAppearance.Evently.Avatar" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="14dp" android:orientation="vertical">
                            <TextView android:id="@+id/tvProfileName" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.Evently.EventTitle" />
                            <TextView android:id="@+id/tvProfileEmail" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.Evently.Meta" android:layout_marginTop="4dp" />
                            <com.google.android.material.chip.Chip android:id="@+id/chipProfileRole" style="@style/Widget.Evently.Category" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" />
                        </LinearLayout>
                    </LinearLayout>
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnEditProfile" style="@style/Widget.Evently.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/profile_edit" android:layout_gravity="end" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <LinearLayout android:id="@+id/cardInfo" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/profile_section_about" android:textAppearance="@style/TextAppearance.Evently.Label" />
                <TextView android:id="@+id/tvProfileBio" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.Evently.Body" android:layout_marginTop="8dp" />
                <TextView android:id="@+id/tvProfilePhoneLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/profile_phone" android:textAppearance="@style/TextAppearance.Evently.Label" android:layout_marginTop="16dp" />
                <TextView android:id="@+id/tvProfilePhone" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.Evently.Meta" android:layout_marginTop="4dp" />
            </LinearLayout>
            <LinearLayout android:id="@+id/cardVerificationDetail" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:orientation="vertical" android:visibility="gone" android:paddingStart="12dp" android:paddingEnd="0dp" android:background="@drawable/bg_verification_accent">
                <TextView android:id="@+id/tvVerificationDetailTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.Evently.EventTitle" />
                <TextView android:id="@+id/tvVerificationDetailBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.Evently.Meta" android:layout_marginTop="8dp" />
            </LinearLayout>
            <com.google.android.material.chip.Chip android:id="@+id/chipProfileVerification" style="@style/Widget.Evently.Category" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnVerifyOrganizer" style="@style/Widget.Evently.TonalButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/profile_become_organizer" android:layout_marginTop="12dp" android:visibility="gone" />
            <com.example.evently.ui.views.AccessibleHeadingTextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/profile_section_account" android:textAppearance="@style/TextAppearance.Evently.Label" android:layout_marginTop="20dp" />
            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" app:cardBackgroundColor="?attr/colorSurfaceContainerLow" app:cardCornerRadius="16dp" app:cardElevation="1dp" app:strokeWidth="0dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="12dp" android:paddingVertical="4dp">
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnSettings" style="@style/Widget.Evently.ActionRow" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/settings_title" app:icon="@drawable/ic_chevron_right" app:iconGravity="end" app:iconTint="?attr/colorOnSurfaceVariant" android:minHeight="52dp" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnAdminDashboard" style="@style/Widget.Evently.ActionRow" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/admin_dashboard_title" android:visibility="gone" app:icon="@drawable/ic_chevron_right" app:iconGravity="end" app:iconTint="?attr/colorOnSurfaceVariant" android:minHeight="52dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/progressBarProfile" android:layout_width="match_parent" android:layout_height="wrap_content" android:indeterminate="true" android:visibility="gone" android:contentDescription="@string/e_loading" />
    <com.example.evently.ui.views.EmptyStateView android:id="@+id/emptyStateProfile" android:layout_width="match_parent" android:layout_height="match_parent" />
</FrameLayout>
