<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationContentDescription="@string/action_back"
        app:navigationIcon="@drawable/ic_back"
        app:title="@string/event_details_title" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/contentDetails"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="12dp"
                android:paddingBottom="24dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="160dp">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/ivDetailImage"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="?attr/colorSurfaceContainerHigh"
                        android:importantForAccessibility="no"
                        android:scaleType="centerCrop"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.Evently.Image" />

                    <androidx.appcompat.widget.AppCompatImageButton
                        android:id="@+id/btnDetailFavorite"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="top|end"
                        android:layout_margin="8dp"
                        android:background="@drawable/bg_event_favorite"
                        android:contentDescription="@string/event_add_favorite"
                        android:elevation="3dp"
                        android:enabled="false"
                        android:padding="14dp"
                        android:src="@drawable/ic_favorite_border"
                        app:tint="?attr/colorPrimary" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvFavoriteError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:accessibilityLiveRegion="polite"
                    android:text="@string/favorite_error"
                    android:textAppearance="@style/TextAppearance.Evently.SettingsSummary"
                    android:textColor="?attr/colorError"
                    android:visibility="gone" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipDetailCategory"
                    style="@style/Widget.Evently.Category"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:visibility="gone" />

                <com.example.evently.ui.views.AccessibleHeadingTextView
                    android:id="@+id/tvDetailTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textAppearance="@style/TextAppearance.Evently.ScreenTitle" />

                <TextView
                    android:id="@+id/tvDetailDateLocation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textAppearance="@style/TextAppearance.Evently.EventTitle"
                    android:textColor="?attr/colorPrimary" />

                <TextView
                    android:id="@+id/tvDetailLocation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:textAppearance="@style/TextAppearance.Evently.Meta" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/bg_group_surface"
                    android:orientation="vertical"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="12dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/e_organizer"
                        android:textAppearance="@style/TextAppearance.Evently.Label" />

                    <TextView
                        android:id="@+id/tvDetailOrganizer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textAppearance="@style/TextAppearance.Evently.Body" />

                    <TextView
                        android:id="@+id/tvDetailVerified"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/verification_verified"
                        android:textAppearance="@style/TextAppearance.Evently.SettingsSummary"
                        android:textColor="@color/colorSuccess"
                        android:visibility="gone" />
                </LinearLayout>

                <com.example.evently.ui.views.AccessibleHeadingTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:text="@string/e_about_event"
                    android:textAppearance="@style/TextAppearance.Evently.EventTitle" />

                <TextView
                    android:id="@+id/tvDetailDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textAppearance="@style/TextAppearance.Evently.Body" />

                <com.example.evently.ui.views.AccessibleHeadingTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:text="@string/e_availability"
                    android:textAppearance="@style/TextAppearance.Evently.EventTitle" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_group_surface"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:id="@+id/tvRegistrationState"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:accessibilityLiveRegion="polite"
                        android:textAppearance="@style/TextAppearance.Evently.Label"
                        android:textColor="?attr/colorPrimary" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/e_participants"
                        android:textAppearance="@style/TextAppearance.Evently.SettingsSummary" />

                    <TextView
                        android:id="@+id/tvParticipantsCount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textAppearance="@style/TextAppearance.Evently.Body" />

                    <TextView
                        android:id="@+id/tvDetailParticipantsLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Evently.SettingsSummary" />

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progressDetailParticipants"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:importantForAccessibility="no"
                        app:trackCornerRadius="2dp"
                        app:trackThickness="4dp" />

                    <LinearLayout
                        android:id="@+id/layoutVolunteers"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/e_volunteers"
                            android:textAppearance="@style/TextAppearance.Evently.SettingsSummary" />

                        <TextView
                            android:id="@+id/tvVolunteersCount"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textAppearance="@style/TextAppearance.Evently.Body" />

                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/progressDetailVolunteers"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="7dp"
                            android:importantForAccessibility="no"
                            app:trackCornerRadius="2dp"
                            app:trackThickness="4dp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layoutOrganizerButtons"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:background="@drawable/bg_group_surface"
                    android:orientation="vertical"
                    android:padding="14dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/e_manage_event"
                        android:textAppearance="@style/TextAppearance.Evently.Label" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnViewRegistrations"
                        style="@style/Widget.Evently.PrimaryButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/organizer_registrations_title" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnEditEvent"
                        style="@style/Widget.Evently.SecondaryButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/event_edit" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDeleteEvent"
                        style="@style/Widget.Evently.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:layout_marginTop="4dp"
                        android:text="@string/event_delete"
                        android:textColor="?attr/colorError" />
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <LinearLayout
            android:id="@+id/layoutJoinButtons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/colorSurfaceContainerLow"
            android:elevation="10dp"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnJoinParticipant"
                style="@style/Widget.Evently.PrimaryButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/event_join_as_participant" />

            <LinearLayout
                android:id="@+id/layoutVolunteerAction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnJoinVolunteer"
                    style="@style/Widget.Evently.SecondaryButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/event_join_as_volunteer" />
            </LinearLayout>
        </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/errorDetails"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/colorBackground"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvDetailsState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityLiveRegion="polite"
                android:gravity="center"
                android:text="@string/d1_event_load_error"
                android:textAppearance="@style/TextAppearance.Evently.Body" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRetryDetails"
                style="@style/Widget.Evently.PrimaryButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/d1_retry" />
        </LinearLayout>

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progressBarDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:contentDescription="@string/e_loading"
            android:indeterminate="true"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
